# Copy to .env and fill in actual values. Never commit .env itself.
# See docs/SHARED_CONTRACT.md for field semantics.

# ── Ingestion ─────────────────────────────────────────────────────────────
SOURCE_ROOT=./notes

# ── Qdrant vector store ───────────────────────────────────────────────────
# For remote/Docker Qdrant, set QDRANT_URL=http://localhost:6333
# For embedded/local mode, leave QDRANT_URL blank and set QDRANT_LOCAL_PATH
QDRANT_URL=
QDRANT_COLLECTION=course_chunks
QDRANT_LOCAL_PATH=./.data/qdrant
# QDRANT_API_KEY=          # only needed for Qdrant Cloud

# ── Embedder & Retrieval ──────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HYBRID_TOP_K=10               # Number of final fused results passed to generator
DENSE_TOP_K=12                # Candidate depth for Qdrant dense search
BM25_TOP_K=12                 # Candidate depth for lexical BM25 search
RRF_K=60                      # Reciprocal Rank Fusion constant

# ── LLM (any OpenAI-compatible endpoint) ─────────────────────────────────
# Option 1: Google Gemini (Free tier: 15 RPM, 1,000,000 TPM, 8,192 output tokens — Recommended)
# Get free key from https://aistudio.google.com/app/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIzaSy...
# LLM_MODEL=gemini-3.5-flash
# LLM_MAX_TOKENS=8192

# Option 2: Groq (Note: Free tier enforces a strict 1000 OTPM ceiling)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_MAX_TOKENS=900

# Option 3: Local Ollama (100% offline, unlimited, free)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_MAX_TOKENS=2048

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192

# ── Web search ────────────────────────────────────────────────────────────
WEB_SEARCH_MODE=auto          # auto | off | tavily | ddgs
TAVILY_API_KEY=               # leave blank to use DDGS (keyless fallback)

# ── OCR ───────────────────────────────────────────────────────────────────
OCR_PROVIDER=disabled         # disabled | paddleocr_vl
OCR_MAX_PAGES=5               # uncached pages to process per run; 0 = unlimited
